meta {
  name: post-routines-routine-id-exercises-error
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/routines/{{managedRoutineId}}/exercises
  body: json
  auth: none
}

headers {
  Authorization: Bearer invalid-demo-token
}

body:json {
  {
    "exercise_id": "{{seedExerciseId}}",
    "day_number": 2,
    "position": 1,
    "sets": 3,
    "reps": 8,
    "rest_seconds": 60
  }
}

tests {
  test("Expected HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Error example for POST /api/v1/routines/{routine_id}/exercises: Missing/invalid authentication. Expected HTTP 401. A passing assertion confirms this intentional error. 
}

