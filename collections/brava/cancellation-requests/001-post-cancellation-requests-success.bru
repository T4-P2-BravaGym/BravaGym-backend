meta {
  name: post-cancellation-requests-success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/cancellation-requests
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{tokenNewMember}}
}

body:json {
  {
    "reason": "Demo de colección Bruno"
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("managedRequestId", res.getBody().id);
}

tests {
  test("Expected HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Operation: POST /api/v1/cancellation-requests. Expected HTTP 201. Run auth and previous folders/requests first. Uses only the local seed and newly captured demo resources; mutations are intentional. Reset a temporary demo database before repeating the whole collection.
}

