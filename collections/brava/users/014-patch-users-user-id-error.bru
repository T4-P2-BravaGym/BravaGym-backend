meta {
  name: patch-users-user-id-error
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/api/v1/users/{{managedUserId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer invalid-demo-token
}

body:json {
  {
    "first_name": "Bruno edited"
  }
}

tests {
  test("Expected HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Error example for PATCH /api/v1/users/{user_id}: Missing/invalid authentication. Expected HTTP 401. A passing assertion confirms this intentional error. 
}

