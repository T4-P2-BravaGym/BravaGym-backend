meta {
  name: patch-users-user-id-role-error
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/users/{{managedUserId}}/role
  body: json
  auth: none
}

headers {
  Authorization: Bearer invalid-demo-token
}

body:json {
  {
    "role": "trainer"
  }
}

tests {
  test("Expected HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Error example for PATCH /api/v1/users/{user_id}/role: Missing/invalid authentication. Expected HTTP 401. A passing assertion confirms this intentional error. 
}

