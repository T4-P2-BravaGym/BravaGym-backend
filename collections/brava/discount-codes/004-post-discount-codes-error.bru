meta {
  name: post-discount-codes-error
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/discount-codes
  body: json
  auth: none
}

headers {
  Authorization: Bearer invalid-demo-token
}

body:json {
  {
    "code": "BRUNO{{runId}}",
    "percent_off": 10,
    "valid_from": "{{today}}",
    "valid_until": "{{discountUntil}}",
    "max_uses": 10
  }
}

tests {
  test("Expected HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Error example for POST /api/v1/discount-codes: Missing/invalid authentication. Expected HTTP 401. A passing assertion confirms this intentional error. 
}

