meta {
  name: post-discount-codes-success
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/discount-codes
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{tokenAdmin}}
}

body:json {
  {
    "code": "BRUNO{{runId}}",
    "percent_off": 10,
    "valid_from": "{{today}}",
    "valid_until": "{{discountUntil}}",
    "max_uses": 10
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("managedCodeId", res.getBody().id);
}

tests {
  test("Expected HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Operation: POST /api/v1/discount-codes. Expected HTTP 201. Run auth and previous folders/requests first. Uses only the local seed and newly captured demo resources; mutations are intentional. Reset a temporary demo database before repeating the whole collection.
}

