meta {
  name: setup-managed-user
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{managedUserEmail}}",
    "password": "{{demoPassword}}",
    "first_name": "Bruno",
    "last_name": "Demo"
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("managedUserId", res.getBody().id);
}

tests {
  test("Expected HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Run auth and earlier requests in collection order against a fresh local seed. See the repository README.
}

