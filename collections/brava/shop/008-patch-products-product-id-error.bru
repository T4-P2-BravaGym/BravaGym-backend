  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/products/{{managedProductId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer invalid-demo-token
}

body:json {
  {
    "price_cents": 1200
  }
}

tests {
  test("Expected HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Error example for PATCH /api/v1/products/{product_id}: Missing/invalid authentication. Expected HTTP 401. A passing assertion confirms this intentional error. 
}

