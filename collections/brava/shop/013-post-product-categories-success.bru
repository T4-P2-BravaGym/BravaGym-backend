meta {
  name: post-product-categories-success
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/product-categories
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{tokenAdmin}}
}

body:json {
  {
    "name": "Bruno category {{runId}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("managedCategoryId", res.getBody().id);
}

tests {
  test("Expected HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Operation: POST /api/v1/product-categories. Expected HTTP 201. Run auth and previous folders/requests first. Uses only the local seed and newly captured demo resources; mutations are intentional. Reset a temporary demo database before repeating the whole collection.
}

