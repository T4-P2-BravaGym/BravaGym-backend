# Copy this file to .env and fill in the values. Never commit .env.
ENVIRONMENT=local
DEBUG=false
DATABASE_URL=sqlite:///./brava.db

# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

JWT_ALGORITHM=HS256
JWT_ISSUER=brava-api
JWT_AUDIENCE=brava-web
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# In-memory TTL for public /plans and /products responses (HU-28)
CACHE_TTL_SECONDS=60

# Auth attempt windows (HU-34). In-memory only — one Uvicorn process.
# Login: failed attempts per email+IP. Register: successful sign-ups per IP.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_MAX_ATTEMPTS=10
AUTH_REGISTER_WINDOW_SECONDS=3600


# Uploaded files (HU-30): product photos go in MEDIA_ROOT/products
MEDIA_ROOT=media
